# =====================================================
# Autonomous AI Sales Voice Agent - Environment Config
# =====================================================
# Copy this file to .env and fill in your actual keys

# --- Groq API Key (FREE) ---
# Get your free API key at: https://console.groq.com/
# Free tier: 14,400 requests/day, 100 req/min
GROQ_API_KEY=your_groq_api_key_here

# --- Groq Model Selection ---
# Free models available: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# --- Application Settings ---
APP_NAME=FORTIVEX AI Sales Agent
APP_VERSION=1.0.0
DEBUG_MODE=False

# --- Database ---
DATABASE_PATH=data/sales_agent.db

# --- TTS Settings ---
# Edge TTS voice options: en-US-AriaNeural, en-US-GuyNeural, en-GB-SoniaNeural
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+10%
TTS_VOLUME=+0%
